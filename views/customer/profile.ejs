<%- include('parts/head') %>
<%- include('parts/navbar') %>

<link rel="stylesheet" href="/css/customer/profile.css">

<!-- Hero -->
<div class="ph-hero">
  <div class="ph-avatar-ring" id="avatarRing" onclick="document.getElementById('avatarInput').click()" 
       style="cursor:pointer;position:relative;" title="اضغط لتغيير الصورة">
    <% if (user && user.Avatar) { %>
      <img src="<%= user.Avatar %>" alt="صورتك" id="avatarImg" style="width:100%;height:100%;object-fit:cover;border-radius:50%;" />
    <% } else { %>
      <i class="ri-user-3-line" id="avatarIcon"></i>
    <% } %>
    <!-- <div style="position:absolute;bottom:0;right:0;background:var(--brand,#e62a32);border-radius:50%;width:30px;height:30px;display:flex;align-items:center;justify-content:center;border:2px solid #fff;">
      <i class="ri-camera-line" style="color:#fff;font-size:.85rem;"></i>
    </div> -->
  </div>
  <input type="file" id="avatarInput" accept="image/*" style="display:none" onchange="uploadAvatar(this)" />
  <div id="avatarProgress" style="display:none;margin-top:8px;">
    <div style="background:rgba(255,255,255,.3);border-radius:20px;height:4px;width:120px;margin:0 auto;">
      <div id="avatarBar" style="background:#fff;height:4px;border-radius:20px;width:0%;transition:width .3s;"></div>
    </div>
    <p style="color:rgba(255,255,255,.9);font-size:.8rem;margin:6px 0 0;">جاري رفع الصورة...</p>
  </div>
  <h2 id="heroName"><%= (user && (user.Customer_Name || user.name)) || 'مستخدم' %></h2>
  <p><i class="ri-mail-line"></i> <span id="heroEmail"><%= (user && (user.Email || user.email)) || '' %></span></p>
</div>

<!-- Main wrap -->
<div class="ph-wrap">

  <!-- Tab nav -->
  <div class="ph-tabs">
    <button class="ph-tab active" onclick="phTab('info',this)">
      <i class="ri-user-line"></i> بياناتي
    </button>
    <button class="ph-tab" onclick="phTab('orders',this)">
      <i class="ri-shopping-bag-2-line"></i> طلباتي
    </button>
    <button class="ph-tab" onclick="phTab('security',this)">
      <i class="ri-shield-keyhole-line"></i> الأمان
    </button>
  </div>

  <!-- ══ TAB: INFO ══ -->
  <div id="ph-info" class="ph-panel active">
    <div class="ph-card">
      <div class="ph-card-head"><i class="ri-edit-2-line"></i> تعديل البيانات الشخصية</div>
      <form id="infoForm">
        <div class="ph-row">
          <div class="ph-field">
            <label>الاسم الكامل</label>
            <input type="text" name="name" value="<%= user?.Customer_Name || user?.name || '' %>" placeholder="اسمك الكامل" required />
          </div>
          <div class="ph-field">
            <label>البريد الإلكتروني</label>
            <input type="email" name="email" value="<%= user?.Email || user?.email || '' %>" placeholder="example@mail.com" required />
          </div>
        </div>
        <div class="ph-field">
          <label>رقم الهاتف</label>
          <input type="tel" name="phone" value="<%= user?.Phone || '' %>" placeholder="01xxxxxxxxx" />
        </div>
        <div class="ph-field">
          <label>عنوان التوصيل الافتراضي</label>
          <textarea name="address" placeholder="الشارع، المبنى، الدور، الشقة..."><%= user?.Address || '' %></textarea>
        </div>
        <button type="submit" class="ph-btn ph-btn-primary" id="saveInfoBtn">
          حفظ التغييرات
        </button>
      </form>
    </div>

    <div class="ph-card">
      <div class="ph-card-head"><i class="ri-logout-box-r-line"></i> تسجيل الخروج</div>
      <button type="button" class="ph-btn ph-btn-danger" onclick="doLogout()">
        <i class="ri-logout-box-line"></i> تسجيل الخروج من الحساب
      </button>
    </div>
  </div>

  <!-- ══ TAB: ORDERS ══ -->
  <div id="ph-orders" class="ph-panel">
    <div id="ordLoading" class="ord-loading">
      <div class="spin"></div>
      <p>جاري تحميل طلباتك...</p>
    </div>
    <div id="ordEmpty" class="ord-empty" style="display:none">
      <i class="ri-shopping-bag-line"></i>
      <h3>لا توجد طلبات بعد</h3>
      <p>ابدأ بطلب وجبتك المفضلة الآن!</p>
      <a href="/menu" class="ph-btn ph-btn-primary" style="width:auto;display:inline-flex;margin-top:8px;">
        <i class="ri-restaurant-line"></i> تصفح القائمة
      </a>
    </div>
    <div id="ordList"></div>
  </div>

  <!-- ══ TAB: SECURITY ══ -->
  <div id="ph-security" class="ph-panel">
    <div class="ph-card">
      <div class="ph-card-head"><i class="ri-lock-password-line"></i> تغيير كلمة المرور</div>
      <form id="passForm">
        <div class="ph-field">
          <label>كلمة المرور الحالية</label>
          <div class="ph-pass-wrap">
            <input type="password" name="currentPassword" id="curPass" placeholder="••••••••" />
            <i class="ri-eye-off-line ph-eye" onclick="togglePass('curPass',this)"></i>
          </div>
        </div>
        <div class="ph-field">
          <label>كلمة المرور الجديدة</label>
          <div class="ph-pass-wrap">
            <input type="password" name="newPassword" id="newPass" placeholder="••••••••" />
            <i class="ri-eye-off-line ph-eye" onclick="togglePass('newPass',this)"></i>
          </div>
        </div>
        <div class="ph-field">
          <label>تأكيد كلمة المرور</label>
          <div class="ph-pass-wrap">
            <input type="password" name="confirmPassword" id="confPass" placeholder="••••••••" />
            <i class="ri-eye-off-line ph-eye" onclick="togglePass('confPass',this)"></i>
          </div>
        </div>
        <button type="submit" class="ph-btn ph-btn-primary" id="savePassBtn">
          <i class="ri-key-2-line"></i> تحديث كلمة المرور
        </button>
      </form>
    </div>
  </div>

</div><!-- /ph-wrap -->

<div id="phToast" class="ph-toast"></div>

<script src="/js/auth/customer.profile.js"></script>

<%- include('parts/footer') %>
