</main>

<!-- REGISTER -->
<main class="main-containers-2 ach">
  <div class="containers">
    <section class="card" aria-labelledby="register-heading">
      <h2 id="register-heading">انشاء حساب جديد</h2>
      <form class="myform" method="POST" action="/user/register" onsubmit="handleRegister(event)">
        <div class="field">
          <label for="reg-username">الاسم الكامل <span aria-hidden="true">*</span></label>
          <input class="input" type="text" id="reg-username" name="username" autocomplete="username" required>
          <p class="drol"></p>
        </div>
        <div class="field">
          <label for="reg-email">البريد الالكتروني <span aria-hidden="true">*</span></label>
          <input class="input" type="email" id="reg-email" name="email" autocomplete="email" required>
          <p class="drol"></p>
        </div>
        <div class="field">
          <label for="reg-phone">رقم الهاتف <span aria-hidden="true">*</span></label>
          <input class="input" type="text" id="reg-phone" name="phone" autocomplete="phone" required>
          <p class="drol"></p>
        </div>
        <div class="field eye">
          <label for="reg-password">كلمة المرور <span aria-hidden="true">*</span></label>
          <input class="input input--password" type="password" id="reg-password" name="password" autocomplete="new-password" required>
          <p class="drol"></p>
        </div>
        <div class="field eye">
          <label for="reg-confirm-password">تأكيد كلمة المرور <span aria-hidden="true">*</span></label>
          <input class="input input--password" type="password" id="reg-confirm-password" name="confirmPassword" autocomplete="new-password" required>
          <p class="drol"></p>
        </div>
        
        <button class="button__submit" type="submit">تسجيل حساب جديد</button>
        <div id="register-msg" style="display:none; margin-top:12px; padding:10px 14px; border-radius:8px; font-size:14px; text-align:center;"></div>
      </form>
    </section>
    <section class="card text-conten">
      <div class="texts">
        <h2>تسجيل دخول</h2>
        <p>التسجيل في هذا الموقع يتيح لك الوصول إلى حالة طلبك وتاريخ طلباتك. فقط قم بملء الحقول أدناه، وسنقوم بإعداد حساب جديد لك في وقت قياسي. سنطلب منك فقط المعلومات الضرورية لتسهيل وتسريع عملية الشراء.</p>
        <button class="button-id-2">تسجيل الدخول</button>
      </div>
    </section>
  </div>
</main>

<div id="errorModal" class="modal">
  <div class="modal-content">
    <span id="closeModal" class="close">&times;</span>
    <p id="modalMessage"></p>
  </div>
</div>

<script src="/js/customer.registration.js"></script>

<script>
// Handle Customer Login with Fetch (prevent page reload and display messages)
async function handleLogin(e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type="submit"]');
  const email = form.querySelector('input[name="email"]').value;
  const password = form.querySelector('input[name="password"]').value;

  if (!email || !password) {
    alert('البريد الإلكتروني وكلمة المرور مطلوبان');
    return;
  }

  if (btn) { btn.disabled = true; btn.textContent = 'جاري التسجيل...'; }

  try {
    const res = await fetch('/user/login', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify({ email, password, remember: form.querySelector('input[name="remember"]')?.checked || false })
    });

    const data = await res.json();

    if (data.success) {
      // Show success message
      alert(data.message || 'تم تسجيل الدخول بنجاح');
      window.location.href = data.redirect || '/';
    } else {
      // Show error message
      alert(data.message || 'البريد الإلكتروني أو كلمة المرور غير صحيحة');
      if (btn) { btn.disabled = false; btn.textContent = 'تسجيل الدخول'; }
    }
  } catch (err) {
    console.error('[Login] Error:', err);
    alert('خطأ في الاتصال بالخادم، حاول مرة أخرى');
    if (btn) { btn.disabled = false; btn.textContent = 'تسجيل الدخول'; }
  }
}

async function handleRegister(e) {
  e.preventDefault();
  const form = e.target;
  const msg = document.getElementById('register-msg');
  const btn = form.querySelector('button[type="submit"]');

  msg.style.display = 'none';
  if (btn) { btn.disabled = true; btn.textContent = 'جاري التسجيل...'; }

  try {
    const res = await fetch(form.action || '/user/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(Object.fromEntries(new FormData(form)))
    });

    const data = await res.json();

    if (data.success || res.ok) {
      msg.style.display = 'block';
      msg.style.background = '#EAF3DE';
      msg.style.color = '#3B6D11';
      msg.style.border = '1px solid #c3e6a0';
      msg.textContent = data.message || 'تم إنشاء الحساب بنجاح!';
      setTimeout(() => {
        window.location.href = data.redirect || '/';
      }, 1500);
    } else {
      msg.style.display = 'block';
      msg.style.background = '#FCEBEB';
      msg.style.color = '#A32D2D';
      msg.style.border = '1px solid #f5b8b8';
      msg.textContent = data.error || data.message || 'حدث خطأ، حاول مرة أخرى';
      if (btn) { btn.disabled = false; btn.textContent = 'تسجيل'; }
    }
  } catch (err) {
    msg.style.display = 'block';
    msg.style.background = '#FCEBEB';
    msg.style.color = '#A32D2D';
    msg.style.border = '1px solid #f5b8b8';
    msg.textContent = 'خطأ في الاتصال، تأكد من الإنترنت وحاول مرة أخرى';
    if (btn) { btn.disabled = false; btn.textContent = 'تسجيل'; }
  }
}
</script>

