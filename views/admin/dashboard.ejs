<!DOCTYPE html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>لوحة التحكم - Foodna Shop</title>
    <link rel="stylesheet" href="/css/shared/variables.css" />
    <link rel="stylesheet" href="/css/shared/design-system.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600&family=Montserrat:wght@400;500;600&family=Oswald:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com">
   <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200..1000&display=swap" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kufam:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  <!-- Oswald -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">
<!-- <link rel="stylesheet" href="/css/product-page.css"> -->
<link rel="stylesheet" href="/css/shared/chatbot.css">
<link rel="stylesheet" href="/css/shared/feature-user-search.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@100;200;300;400;500;600;700&family=Kufam:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
      <link rel="stylesheet" href="/css/admin/dashboard.style.css" />
  </head>
  <body>
    <div class="dashboard-container">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
          <h2>لوحة التحكم</h2>
          <button class="sidebar-toggle" id="sidebarToggle">☰</button>
        </div>
        <nav class="sidebar-nav">
          <a href="#" class="nav-item active" data-section="dashboard">
            <i class="ri-dashboard-line"></i>
            <span>لوحة المعلومات</span>
          </a>
          <a href="#" class="nav-item" data-section="products">
            <i class="ri-shopping-bag-line"></i>
            <span>المنتجات</span>
          </a>
          <a href="#" class="nav-item" data-section="customers">
            <i class="ri-user-line"></i>
            <span>العملاء</span>
          </a>
          <a href="#" class="nav-item" data-section="orders">
            <i class="ri-shopping-cart-line"></i>
            <span>الطلبات</span>
          </a>
          <a href="#" class="nav-item" data-section="categories">
            <i class="ri-folder-line"></i>
            <span>التصنيفات</span>
          </a>
          <a href="#" class="nav-item" data-section="offers">
            <i class="ri-price-tag-3-line"></i>
            <span>العروض</span>
          </a>
          <a href="#" class="nav-item" data-section="coupons">
            <i class="ri-coupon-line"></i>
            <span>الكوبونات</span>
          </a>
          <a href="#" class="nav-item" data-section="inventory">
            <i class="ri-archive-line"></i>
            <span>المخزون</span>
          </a>
        </nav>
      </aside>

      <main class="main-content">
        <header class="topbar">
          <div class="topbar-left">
            <button class="mobile-toggle" id="mobileToggle">☰</button>
            <h1 id="pageTitle">لوحة المعلومات</h1>
          </div>
          
            <div class="search-box">
             
              <input
                type="text"
                placeholder="بحث في المنتجات والعملاء والطلبات..."
                id="searchInput"
                class="form-control"
                style="width: 300px; padding-right: 40px;"
              />
            </div>
            <div class="user-menu">
              <span class="user-name"><%= user.name %></span>
              <div
                class="user-avatar"
                style="
                  width: 40px;
                  height: 40px;
                  border-radius: 50%;
                  background: var(--main-color);
                  color: white;
                  display: flex;
                  align-items: center;
                  justify-content: center;
                  font-weight: bold;
                "
              >
                <%= user.name.charAt(0) %>
              </div>
            
          </div>
        </header>

        <div class="content">
          <section id="dashboard-section" class="section active">
            <div class="stats-grid">
              <div class="stat-card">
                <div class="stat-icon blue">💰</div>
                <div class="stat-details">
                  <p class="stat-label">إجمالي الإيرادات</p>
                  <h3 class="stat-value" id="totalRevenue">0.00</h3>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon green">🛍️</div>
                <div class="stat-details">
                  <p class="stat-label">إجمالي الطلبات</p>
                  <h3 class="stat-value" id="totalOrders">0</h3>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon orange">📦</div>
                <div class="stat-details">
                  <p class="stat-label">إجمالي المنتجات</p>
                  <h3 class="stat-value" id="totalProducts">0</h3>
                </div>
              </div>
              <div class="stat-card">
                <div class="stat-icon purple">👥</div>
                <div class="stat-details">
                  <p class="stat-label">إجمالي العملاء</p>
                  <h3 class="stat-value" id="totalCustomers">0</h3>
                </div>
              </div>
            </div>

            <div
              class="charts-grid"
              style="
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: var(--spacing-lg);
              "
            >
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">نظرة عامة على الإيرادات</h3>
                </div>
                <div class="card-body">
                  <div
                    class="period-selector"
                    style="
                      display: flex;
                      gap: var(--spacing-sm);
                      margin-bottom: var(--spacing-md);
                    "
                  >
                    <button
                      class="btn btn-outline period-btn active"
                      data-period="daily"
                    >
                      يومي
                    </button>
                    <button
                      class="btn btn-outline period-btn"
                      data-period="weekly"
                    >
                      أسبوعي
                    </button>
                    <button
                      class="btn btn-outline period-btn"
                      data-period="monthly"
                    >
                      شهري
                    </button>
                  </div>
                  <canvas id="revenueChart" style="max-height: 300px"></canvas>
                </div>
              </div>
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">الطلبات الأخيرة</h3>
                </div>
                <div class="card-body">
                  <div class="recent-orders" id="recentOrdersList"></div>
                </div>
              </div>
            </div>
          </section>

          <section id="products-section" class="section">
            <div class="section-header">
              <h2>إدارة المنتجات</h2>
              <button class="btn btn-primary" id="addProductBtn">
                <i class="ri-add-line"></i> إضافة منتج
              </button>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th class="important">المعرف</th>
                    <th class="important">اسم المنتج</th>
                    <th class="secondary">الفئة</th>
                    <th class="important">السعر</th>
                    <th class="secondary">خصم (%)</th>
                    <th class="secondary">المخزون</th>
                    <th class="secondary">الحالة</th>
                    <th class="actions">الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="productsTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="customers-section" class="section">
            <div class="section-header">
              <h2>إدارة العملاء</h2>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th class="important">المعرف</th>
                    <th class="important">الاسم</th>
                    <th class="secondary">البريد الإلكتروني</th>
                    <th class="secondary">الهاتف</th>
                    <th class="secondary">إجمالي الطلبات</th>
                    <th class="secondary">إجمالي الإنفاق</th>
                    <th class="actions">الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="customersTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="orders-section" class="section">
            <div class="section-header">
              <h2>إدارة الطلبات</h2>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th class="important">رقم الطلب</th>
                    <th class="important">العميل</th>
                    <th class="secondary">التاريخ</th>
                    <th class="important">الإجمالي</th>
                    <th class="secondary">الحالة</th>
                    <th class="actions">الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="ordersTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="categories-section" class="section">
            <div class="section-header">
              <h2>إدارة التصنيفات</h2>
              <button class="btn btn-primary" id="addCategoryBtn">
                <i class="ri-add-line"></i> إضافة تصنيف
              </button>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th class="important">المعرف</th>
                    <th class="important">اسم التصنيف</th>
                    <th class="secondary">الوصف</th>
                    <th class="secondary">عدد المنتجات</th>
                    <th class="actions">الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="categoriesTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="offers-section" class="section">
            <div class="section-header">
              <h2>إدارة العروض</h2>
              <button class="btn btn-primary" id="addOfferBtn">
                <i class="ri-add-line"></i> إضافة عرض
              </button>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th>المعرف</th>
                    <th>اسم العرض</th>
                    <th>الوصف</th>
                    <th>نوع الخصم</th>
                    <th>قيمة الخصم</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="offersTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="coupons-section" class="section">
            <div class="section-header">
              <h2>إدارة الكوبونات</h2>
              <button class="btn btn-primary" id="addCouponBtn">
                <i class="ri-add-line"></i> إضافة كوبون
              </button>
            </div>
            <div class="table-container">
              <table class="table">
                <thead>
                  <tr>
                    <th>الكود</th>
                    <th>نوع الخصم</th>
                    <th>قيمة الخصم</th>
                    <th>تاريخ الانتهاء</th>
                    <th>عدد الاستخدامات</th>
                    <th>الحالة</th>
                    <th>الإجراءات</th>
                  </tr>
                </thead>
                <tbody id="couponsTableBody"></tbody>
              </table>
            </div>
          </section>

          <section id="inventory-section" class="section">
            <div class="section-header">
              <h2>إدارة المخزون</h2>
            </div>
            <div
              style="
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                gap: var(--spacing-lg);
              "
            >
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">تنبيه المخزون المنخفض</h3>
                </div>
                <div class="card-body">
                  <div id="lowStockList"></div>
                </div>
              </div>
              <div class="card">
                <div class="card-header">
                  <h3 class="card-title">مستويات المخزون</h3>
                </div>
                <div class="card-body">
                  <div id="stockLevelsList"></div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </main>
    </div>

    <div
      id="modal"
      class="modal"
    >
      <div class="modal-content">
        <div class="modal-header">
          <h2 id="modalTitle">عنوان النافذة</h2>
          <button class="modal-close" id="modalClose">&times;</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin/dashboard.script.js"></script>
  </body>
</html>
