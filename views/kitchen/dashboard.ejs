<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة تحكم المطبخ - Foodna Shop</title>
    <link rel="stylesheet" href="/css/shared/variables.css" />
    <link rel="stylesheet" href="/css/shared/design-system.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600&family=Montserrat:wght@400;500;600&family=Oswald:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    
    
    <link rel="stylesheet" href="/css/kitchen/kitchen.css">
</head>
<body>
    <div class="kitchen-header">
        <div class="container content-header" >
            <h1><i class="ri-restaurant-line"></i> مطبخ Foodna Shop</h1>
            <p>مرحباً، <%= user.name %> | <span id="currentTime"></span></p>
        </div>
    </div>

    <div class="container">
        <div id="ordersContainer" class="orders-grid">
            <!-- الطلبات سيتم إضافتها هنا -->
        </div>

        <div id="noOrders" class="no-orders" style="display: none;">
            <i class="ri-checkbox-circle-line"></i>
            <h2>لا توجد طلبات حالياً</h2>
            <p>جميع الطلبات مكتملة</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/kitchen/kitchen.js"></script>
</body>
</html>

