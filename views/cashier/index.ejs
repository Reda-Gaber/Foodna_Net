<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Simple POS System</title>
    <link rel="stylesheet" href="/css/cashier/index.css"/>
</head>
<body>
    <div class="container">
        <header>
            <h1>مقهى النخبة - نظام الطلبات</h1>
            <input 
                type="text" 
                id="searchInput" 
                class="search-bar" 
                placeholder="ابحث عن منتج..." 
            />
        </header>

        <div class="main-content">
            <!-- Products Section -->
            <section class="products-section">
                <h2 class="section-title">المنتجات</h2>
                <div id="productsGrid" class="products-grid">
                    <!-- Products will be injected here by JavaScript -->
                </div>
            </section>

            <!-- Cart Section -->
            <aside class="cart-section">
                <h2 class="section-title">سلة الطلبات</h2>
                <div id="cartItems" class="cart-items">
                    <p class="empty-cart">لا توجد عناصر في السلة</p>
                </div>
                <div id="cartTotal" class="cart-total">الإجمالي: 0.00 جنيه</div>
                <button id="payBtn" class="pay-btn" disabled>دفع</button>
            </aside>
        </div>
    </div>

    <script src="/js/cashier/cashier.index.js"></script>
</body>
</html>