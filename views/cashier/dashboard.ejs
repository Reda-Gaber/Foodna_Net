<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نقاط البيع - Foodna Shop</title>
    <link rel="stylesheet" href="/css/shared/design-system.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600&family=Montserrat:wght@400;500;600&family=Oswald:wght@400;500;600&display=swap" rel="stylesheet">
    
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Kufam:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/shared/sweetalert-config.js"></script>
    <link rel="stylesheet" href="/css/cashier/dashboard.css">
</head>
<body>

    <!-- Header -->
    <div class="cashier-header">
        <div class="container">
            <h1><i class="ri-cash-register-line"></i> نقاط البيع — Foodna Shop</h1>
            <p>مرحباً، <%= user.name %> &nbsp;|&nbsp; <span id="currentTime"></span></p>
        </div>
    </div>

    <!-- Page Tabs -->
    <div class="page-tabs">
        <button class="tab-btn active" data-tab="pos">
            <i class="ri-store-2-line"></i> نقطة البيع
        </button>
        <button class="tab-btn" data-tab="orders">
            <i class="ri-clipboard-line"></i> إدارة الطلبات
            <span class="tab-badge" id="pendingBadge" style="display:none">0</span>
        </button>
    </div>

    <!-- ========================= TAB: POS ========================= -->
    <div class="tab-panel active" id="tab-pos">
        <div class="container">
            <div class="main-layout">

                <!-- قسم المنتجات -->
                <section class="products-section">
                    <h2 class="card-title">المنتجات</h2>
                    <input type="text" id="searchInput" class="search-bar" placeholder="ابحث عن منتج..."/>
                    <div id="productsGrid" class="products-grid">
                        <div class="skeleton-cell" style="height:120px; border-radius:8px;"></div>
                        <div class="skeleton-cell" style="height:120px; border-radius:8px;"></div>
                        <div class="skeleton-cell" style="height:120px; border-radius:8px;"></div>
                        <div class="skeleton-cell" style="height:120px; border-radius:8px;"></div>
                    </div>
                </section>

                <!-- قسم السلة -->
                <aside class="cart-section">
                    <h2 class="card-title">سلة الطلبات</h2>
                    <div id="cartItems" class="cart-items">
                        <div class="empty-cart">
                            <i class="ri-shopping-cart-line" style="font-size:3rem;color:var(--border-color);"></i>
                            <p>السلة فارغة</p>
                        </div>
                    </div>

                    <div class="cart-summary">
                        <div class="summary-row summary-total">
                            <span>الإجمالي:</span>
                            <span><span id="totalAmount">0.00</span> جنيه</span>
                        </div>
                    </div>

                    <div class="payment-section" style="margin-top:var(--spacing-md)">
                        <label class="form-label">طريقة الدفع</label>
                        <div class="payment-methods">
                            <label class="payment-method active">
                                <input type="radio" name="paymentMethod" value="cash" checked>
                                <i class="ri-money-dollar-circle-line" style="font-size:1.5rem;display:block;margin-bottom:0.4rem;"></i>
                                نقدي
                            </label>
                            <label class="payment-method">
                                <input type="radio" name="paymentMethod" value="card">
                                <i class="ri-bank-card-line" style="font-size:1.5rem;display:block;margin-bottom:0.4rem;"></i>
                                بطاقة
                            </label>
                        </div>
                    </div>

                    <button id="checkoutBtn" class="btn btn-primary" style="width:100%;margin-top:var(--spacing-md);" disabled>
                        <i class="ri-check-line"></i> إتمام الدفع
                    </button>
                </aside>

            </div>
        </div>
    </div>

    <!-- ========================= TAB: ORDERS ========================= -->
    <div class="tab-panel" id="tab-orders">
        <div class="orders-panel">

            <div class="orders-toolbar">
                <h2><i class="ri-clipboard-line"></i> إدارة الطلبات</h2>

                <div class="filter-tabs">
                    <button class="filter-tab active" data-filter="all">الكل</button>
                    <button class="filter-tab" data-filter="active">نشطة</button>
                    <button class="filter-tab" data-filter="completed">مكتملة</button>
                </div>

                <button class="btn-refresh" id="refreshOrdersBtn">
                    <i class="ri-refresh-line"></i> تحديث
                </button>
            </div>

            <div class="orders-table-wrap">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>رقم الطلب</th>
                            <th>العميل</th>
                            <th>الإجمالي</th>
                            <th>طريقة الدفع</th>
                            <th>وقت الطلب</th>
                            <th>الحالة الحالية</th>
                            <th>تغيير الحالة</th>
                        </tr>
                    </thead>
                    <tbody id="ordersTableBody">
                        <!-- skeleton -->
                        <tr class="skeleton-row"><td><div class="skeleton-cell" style="width:60px"></div></td><td><div class="skeleton-cell" style="width:100px"></div></td><td><div class="skeleton-cell" style="width:70px"></div></td><td><div class="skeleton-cell" style="width:80px"></div></td><td><div class="skeleton-cell" style="width:110px"></div></td><td><div class="skeleton-cell" style="width:90px"></div></td><td><div class="skeleton-cell" style="width:130px"></div></td></tr>
                        <tr class="skeleton-row"><td><div class="skeleton-cell" style="width:60px"></div></td><td><div class="skeleton-cell" style="width:120px"></div></td><td><div class="skeleton-cell" style="width:70px"></div></td><td><div class="skeleton-cell" style="width:80px"></div></td><td><div class="skeleton-cell" style="width:110px"></div></td><td><div class="skeleton-cell" style="width:90px"></div></td><td><div class="skeleton-cell" style="width:130px"></div></td></tr>
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    <!-- ========================= ORDER DETAILS DRAWER ========================= -->
    <div class="drawer-overlay" id="drawerOverlay"></div>
    <div class="order-drawer" id="orderDrawer">
        <div class="drawer-header">
            <h3><i class="ri-file-list-3-line"></i> تفاصيل الطلب <span id="drawerOrderId"></span></h3>
            <button class="drawer-close" id="closeDrawerBtn"><i class="ri-close-line"></i></button>
        </div>
        <div class="drawer-body" id="drawerBody">
            <!-- filled by JS -->
        </div>
    </div>

    <script src="/js/cashier/cashier.dashboard.js"></script>
</body>
</html>
