<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نقاط البيع - Foodna Shop POS</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link rel="stylesheet" href="/css/cashier/pos-enhanced.css">
</head>
<body>
    <div class="pos-container">
        <!-- HEADER -->
        <div class="pos-header">
            <div>
                <h1> نقاط البيع - Foodna Shop</h1>
            </div>
            <div class="pos-header-info">
                <div class="header-user">
                    <i class="ri-user-line"></i>
                    <span id="cashierName">الكاشير</span>
                </div>
                <div class="header-user">
                    <i class="ri-time-line"></i>
                    <span id="currentTime">--:--</span>
                </div>
                <button class="logout-btn" onclick="logout()">تسجيل الخروج</button>
            </div>
        </div>

        <!-- MAIN CONTENT -->
        <div class="pos-main">
            <!-- PRODUCTS SECTION -->
            <div class="products-section">
                <div class="product-controls">
                    <input 
                        type="text" 
                        id="searchInput" 
                        class="search-input" 
                        placeholder="🔍 ابحث عن منتج..."
                        autocomplete="off"
                    >
                    <div class="category-tabs" id="categoryTabs">
                        <div class="category-tab active" data-category="all">جميع الفئات</div>
                    </div>
                </div>
                <div class="products-grid" id="productsGrid">
                    <div class="empty-cart">
                        <i class="ri-inbox-line"></i>
                        <p>جاري تحميل المنتجات...</p>
                    </div>
                </div>
            </div>

            <!-- CART SECTION -->
            <div class="cart-section">
                <div class="cart-header">
                    <h2>
                        <i class="ri-shopping-cart-2-line"></i>
                        السلة
                        <span class="cart-title-count" id="cartCount">0</span>
                    </h2>
                    <i class="ri-close-line" style="cursor: pointer;" onclick="toggleCart()"></i>
                </div>

                <div class="cart-items" id="cartItems">
                    <div class="empty-cart">
                        <i class="ri-shopping-cart-line"></i>
                        <p>السلة فارغة</p>
                    </div>
                </div>

                <!-- NOTES SECTION -->
                <div class="notes-section">
                    <label for="orderNotes">ملاحظات الطلب:</label>
                    <textarea 
                        id="orderNotes" 
                        class="notes-textarea" 
                        placeholder="أضف ملاحظات خاصة بالطلب..."
                    ></textarea>
                </div>

                <!-- COUPON SECTION -->
                <div class="coupon-section">
                    <label>كود التخفيف:</label>
                    <div class="coupon-input-group">
                        <input 
                            type="text" 
                            id="couponInput" 
                            class="coupon-input" 
                            placeholder="أدخل الكود..."
                        >
                        <button class="coupon-btn" id="applyCouponBtn" onclick="applyCoupon()">تطبيق</button>
                    </div>
                    <div id="couponStatus"></div>
                </div>

                <!-- TOTALS SECTION -->
                <div class="totals-section">
                    <div class="total-row">
                        <span class="total-label">الإجمالي الفرعي:</span>
                        <span class="total-value" id="subtotal">0.00 ر.س</span>
                    </div>
                    <div class="total-row discount-row" id="discountRow" style="display: none;">
                        <span class="total-label">التخفيف:</span>
                        <span class="total-value" id="discountAmount">0.00 ر.س</span>
                    </div>
                    <div class="total-row">
                        <span class="total-label">الضريبة (15%):</span>
                        <span class="total-value" id="tax">0.00 ر.س</span>
                    </div>
                    <div class="total-row">
                        <span class="total-label">رسم الخدمة:</span>
                        <span class="total-value" id="serviceFee">0.00 ر.س</span>
                    </div>
                    <div class="grand-total" id="grandTotal">0.00 ر.س</div>
                </div>

                <!-- PAYMENT METHOD -->
                <div class="payment-section">
                    <label class="payment-label">طريقة الدفع:</label>
                    <div class="payment-methods">
                        <button class="payment-method-btn active" data-method="cash" onclick="setPaymentMethod('cash')">
                            <i class="ri-money-dollar-circle-line"></i> نقد
                        </button>
                        <button class="payment-method-btn" data-method="card" onclick="setPaymentMethod('card')">
                            <i class="ri-bank-card-line"></i> بطاقة
                        </button>
                        <button class="payment-method-btn" data-method="mobile" onclick="setPaymentMethod('mobile')">
                            <i class="ri-wallet-line"></i> محفظة
                        </button>
                    </div>
                    <div class="cash-input-group show" id="cashInputGroup">
                        <input 
                            type="number" 
                            id="amountReceived" 
                            class="amount-input"
                            placeholder="المبلغ المستلم"
                            oninput="calculateChange()"
                        >
                        <div class="change-display" id="changeDisplay">الباقي: 0.00 ر.س</div>
                    </div>
                </div>

                <!-- ACTION BUTTONS -->
                <div class="action-buttons">
                    <button class="action-btn clear-btn" onclick="cancelOrder()" id="cancelBtn">إلغاء الطلب</button>
                    <button class="action-btn checkout-btn" onclick="completeOrder()" id="checkoutBtn">✓ إتمام البيع</button>
                </div>
            </div>
        </div>
    </div>
   <script src="/js/cashier/cashier.enhanced.js"></script>
</body>
</html>
